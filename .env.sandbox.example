# a sovereign LLM behind an anonymisation gateway (component C6/C7).
LLM_PROVIDER=openai_compat
LLM_ENDPOINT=https://<llm-gateway-host>/v1
LLM_MODEL=<model-id>
LLM_API_KEY=<issued-by-gateway-operator>

# e-Līgumi store (component C5)
ELIGUMI_TENANT_SLUG=demo
ELIGUMI_TENANT_NAME=Demo organizācija
ELIGUMI_API_KEY=<random-32-bytes>
ELIGUMI_UI_USER=demo
ELIGUMI_UI_PASSWORD=<set-me>

# Edge
EDGE_BIND=127.0.0.1
EDGE_PORT=28100
