# syntax=docker/dockerfile:1
#
# UAPF reference runtime (UAPFormat/uapf-engine).
# Multi-stage build into a thin Node 20 image.
#
# Build context: project root.
# Run:           docker compose up -d uapf-engine
# Env:           PACKAGES_DIR (default /packages), UAPF_SCHEMAS_DIR (/uapf-schemas),
#                PORT (default 4000).

FROM node:20-bookworm-slim AS builder
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && apt-get clean \
 && find /var/lib/apt/lists -mindepth 1 -delete

ARG UAPF_ENGINE_REF=main
WORKDIR /build
RUN git clone https://github.com/UAPFormat/uapf-engine.git . \
 && git checkout ${UAPF_ENGINE_REF} \
 && npm install --omit=dev --silent \
 && npm install --silent typescript ts-node \
 && npx tsc -p tsconfig.json

FROM node:20-bookworm-slim AS runtime
ENV NODE_ENV=production \
    PORT=4000 \
    PACKAGES_DIR=/packages \
    UAPF_SCHEMAS_DIR=/uapf-schemas
WORKDIR /app
COPY --from=builder /build/dist        ./dist
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/package.json ./package.json
COPY --from=builder /build/public       ./public
RUN mkdir -p /packages /uapf-schemas
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD node -e "require('http').get('http://localhost:4000/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "dist/http/server.js"]
