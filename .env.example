# ============================================================
# OpenLegal environment configuration
# Copy this file to `.env` and adjust for your environment.
# `.env` is git-ignored.
# ============================================================

# --- Core ---
OPENLEGAL_ENV=development                    # development | staging | production
OPENLEGAL_DEBUG=true
OPENLEGAL_BASE_URL=http://api:8002
OPENLEGAL_FRONTEND_URL=http://localhost:8080
OPENLEGAL_LOG_LEVEL=INFO

# --- Database ---
OPENLEGAL_DB_URL=postgresql+asyncpg://openlegal:openlegal@db:5432/openlegal
POSTGRES_USER=openlegal
POSTGRES_PASSWORD=openlegal
POSTGRES_DB=openlegal

# --- Cache / queue ---
OPENLEGAL_REDIS_URL=redis://cache:6379/0

# --- Auth (JWT) ---
OPENLEGAL_JWT_SECRET=change-me-in-production
OPENLEGAL_JWT_ALGORITHM=HS256
OPENLEGAL_JWT_EXPIRY_MINUTES=480

# --- VeriDocs SDK sidecar ---
OPENLEGAL_SDK_URL=http://sdk:3101
OPENLEGAL_HOST_DID=did:web:openlegal.local

# These are read by the SDK sidecar itself, not by OpenLegal directly.
# Point at the VeriDocs Register the SDK should sync with.
REGISTRY_URL=https://register.veritrust.local
REGISTRY_EMAIL=changeme@example.com
REGISTRY_PASSWORD=changeme

# --- UAPF engine ---
OPENLEGAL_UAPF_ENABLED=true
OPENLEGAL_UAPF_ENGINE_URL=http://uapf-engine:4001
OPENLEGAL_UAPF_ENGINE_AUTH_TOKEN=change-me-in-production
OPENLEGAL_PROCESSGIT_URL=                    # optional: auto-fetch packages from ProcessGit

# --- OpenDMS evidence integration ---
OPENLEGAL_OPENDMS_ENABLED=true
OPENLEGAL_OPENDMS_URL=http://opendms-api:8002
OPENLEGAL_OPENDMS_ORG_ID=

# --- LLM gateway ---
OPENLEGAL_LLM_PROVIDER=anthropic             # anthropic | sandbox | local
OPENLEGAL_LLM_MODEL=claude-haiku-4-5
OPENLEGAL_LLM_ENDPOINT=                      # leave blank for provider default
ANTHROPIC_API_KEY=
SANDBOX_LLM_TOKEN=

# --- Storage for attachments (routed through OpenDMS by default) ---
OPENLEGAL_STORAGE_BACKEND=local              # local | s3 | azure
OPENLEGAL_STORAGE_LOCAL_PATH=/data/openlegal/attachments
# S3 backend
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Azure backend
OPENLEGAL_STORAGE_AZURE_CONNECTION_STRING=
OPENLEGAL_STORAGE_AZURE_CONTAINER=

# --- Intake adapters (configured per-deployment via admin UI; here only for local dev) ---
ZABBIX_API_URL=
ZABBIX_API_TOKEN=
ZABBIX_WEBHOOK_SECRET=
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=

# Jira DC (on-prem profile)
JIRA_DC_BASE_URL=
JIRA_DC_PAT=
JIRA_DC_PROJECT_KEY=
JIRA_DC_WEBHOOK_SECRET=

# Jira Cloud (sandbox profile)
JIRA_CLOUD_TENANT=                          # e.g. your-site.atlassian.net
JIRA_CLOUD_AUTH_METHOD=api_token            # api_token | oauth2
JIRA_CLOUD_API_TOKEN=
JIRA_CLOUD_BOT_EMAIL=
JIRA_CLOUD_PROJECT_KEY=
JIRA_CLOUD_WEBHOOK_TOPOLOGY=relay           # relay | dmz
JIRA_CLOUD_WEBHOOK_RELAY_URL=https://webhook-relay.algomation.io
JIRA_CLOUD_WEBHOOK_SIGNING_SECRET=

# --- CORS ---
OPENLEGAL_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
